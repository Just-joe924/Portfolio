# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# The origin the site is served from, with no trailing slash. Canonical links,
# the sitemap and the social card are all built from it, so it has to match the
# real domain or search engines see every page as a copy of one that doesn't
# resolve. Leave it unset locally; on Vercel set it to the deployment URL
# (https://your-project.vercel.app) until a custom domain is attached, then to
# the domain. Defaults to the domain on the CV.
NEXT_PUBLIC_SITE_URL=

# From https://resend.com/api-keys — a "Sending access" key is enough.
RESEND_API_KEY=re_xxxxxxxx

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=you@example.com

# Who they're sent from. Resend's test sender works without a verified domain,
# but only delivers to the address your Resend account was created with. Once
# you verify a domain, switch to something like "Portfolio <contact@yourdomain.com>".
CONTACT_FROM_EMAIL="Portfolio contact form <onboarding@resend.dev>"
